{
  "expo": {
    "name": "دروس سبوت",
    "slug": "DrosSpot",
    "version": "1.2.4",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f537825e-3329-40d0-827a-aa708f228509",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "drosspot",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.drosspot.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "30"
    },
    "android": {
      "package": "com.drosspot.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FBFBFB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 21,
      "edgeToEdgeEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#FBFBFB",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 160
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://drosspot.app/api/v1",
      "router": {},
      "eas": {
        "projectId": "f537825e-3329-40d0-827a-aa708f228509"
      },
      "appId": "com.drosspot.app"
    }
  }
}
