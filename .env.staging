# stg.drosspot.app — PUBLIC values of a staging build. The access key is NOT here: pass
# EXPO_PUBLIC_STAGING_KEY from a secret (GitHub: STAGING_ACCESS_KEY) or your shell.
#   npm run start:staging        # Metro against staging
#   npm run build:staging:apk    # Android staging APK (needs google-services.staging.json)
EXPO_PUBLIC_APP_ENV=staging
EXPO_PUBLIC_API_URL=https://stg.drosspot.app/api/v1
